{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nagarik Signal agent handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "task_id",
    "status",
    "summary",
    "changed_files",
    "commands",
    "tests_added",
    "risks",
    "contract_changes",
    "rollback_impact",
    "commit_sha"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3}$"
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "failed",
        "review_only"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tests_added": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contract_changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rollback_impact": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
