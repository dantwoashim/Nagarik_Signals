# Runtime identity
NODE_ENV=development
NAGARIK_RELEASE_PROFILE=curated_pilot_v2_non_mainnet
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_RELEASE_ID=0000000000000000000000000000000000000000
NEXT_PUBLIC_NAGARIK_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Postgres and managed authentication
NAGARIK_WORKFLOW_STORE=postgres
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NAGARIK_AUTH_JWKS_URL=https://replace.invalid/auth/v1/.well-known/jwks.json
NAGARIK_AUTH_ISSUER=https://replace.invalid/auth/v1
NAGARIK_AUTH_AUDIENCE=authenticated
NAGARIK_AUTH_AAL2_REQUIRED=true

# Private object storage
NAGARIK_STORAGE_MODE=local
BLOB_READ_WRITE_TOKEN=
NAGARIK_BLOB_ACCESS=private
NAGARIK_BLOB_STAGING_PREFIX=staging/nagarik/
NAGARIK_BLOB_DURABLE_PREFIX=private/nagarik/

# Solana v1 read compatibility and v2 worker profile
NAGARIK_SOLANA_CLUSTER=localnet
NAGARIK_RPC_PRIMARY_URL=https://replace.invalid/rpc-primary
NAGARIK_RPC_SECONDARY_URL=https://replace.invalid/rpc-secondary
NAGARIK_SOLANA_GENESIS_HASH=
NAGARIK_V1_PROGRAM_ID=76PwNDW9hANj3tiebTEUdAj4yHYHVMfjcVDPjUWLQmqY
NAGARIK_V2_PROGRAM_ID=A1PDikCUQekCAbc8CHcZgEFwxxhEyspfHGEbG7PX4URP
NAGARIK_V1_IDL_SHA256=776832A82DB6C76B8165614327D866C182E60FC2D121C9536410D016C032A61A
NAGARIK_V2_IDL_SHA256=1971B3D2743CA3F51332CC92D988A2FE75792F333474E680C3F2D7F7AE15A962
NAGARIK_V2_SIGNER_PUBLIC_KEY=
NAGARIK_V2_SIGNER_ENDPOINT=
NAGARIK_V2_SIGNER_AUTH_SECRET=
NAGARIK_V2_SIGNER_CUSTODY_ID=cloudflare-secret/nagarik-v2-signer
# Local/test only. Production rejects filesystem signer custody.
NAGARIK_V2_LOCAL_SIGNER_PATH=

# Independent server-only secrets, each at least 32 random characters
NAGARIK_CAPABILITY_DERIVATION_KEY=
NAGARIK_CAPABILITY_VERIFIER_KEY=
NAGARIK_SECURITY_CORRELATION_KEY=
NAGARIK_COOKIE_SECRET=
NAGARIK_CSRF_SECRET=
NAGARIK_WORKER_AUTH_SECRET=
# The approved scheduler sends this only to exact production cron GET routes.
CRON_SECRET=

# Redacted operational alert delivery. The endpoint accepts a bearer token and
# must not depend on URL query credentials.
NAGARIK_ALERT_WEBHOOK_URL=https://alerts.example/nagarik
NAGARIK_ALERT_WEBHOOK_TOKEN=

# Frozen release invariants
NAGARIK_LEGACY_READ=true
NAGARIK_LEGACY_MUTATIONS=false
NAGARIK_PUBLIC_READ=true
NAGARIK_PUBLIC_INTAKE=false
NAGARIK_PUBLIC_SIGNALS=false
NAGARIK_MAINNET_WRITES=false
NAGARIK_PUBLICATION_REQUIRES_FINALIZED_COMMIT=true
NAGARIK_SAMPLE_DATA=false

# Static capability ceilings. Database and edge kill switches still start closed.
NAGARIK_CAP_PUBLIC_READ=true
NAGARIK_CAP_PUBLIC_MEDIA=true
NAGARIK_CAP_INVITE_INTAKE=true
NAGARIK_CAP_INVITE_SIGNALS=true
NAGARIK_CAP_OPERATOR_MUTATIONS=true
NAGARIK_CAP_PUBLICATION=true
NAGARIK_CAP_V2_WRITES=true

# Real civic intake remains disabled until the external privacy/legal gate exists.
NAGARIK_ALLOW_REAL_CIVIC_DATA=false
NAGARIK_EXT003_REFERENCE=

# Bounded technical retention
NAGARIK_STAGING_TTL_HOURS=24
NAGARIK_PRIVATE_RETENTION_DAYS=90
NAGARIK_LOG_RETENTION_DAYS=30
NAGARIK_SCHEMA_VERSION=1
NAGARIK_ALLOWED_ORIGINS=http://localhost:3001

# Legacy prototype variables are intentionally absent. Production validation
# rejects shared steward/reindex secrets, relayer private keys, session-wallet
# derivation secrets, and the old JSON workflow store.
