{
  "name": "nagarik-signal",
  "version": "0.1.0",
  "private": true,
  "description": "Public proof for public problems.",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.10.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nagarik-signal/web",
    "start": "npm run start --workspace @nagarik-signal/web",
    "build": "npm run build --workspace @nagarik-signal/web",
    "lint": "npm run lint --workspace @nagarik-signal/web",
    "typecheck": "npm run typecheck --workspace @nagarik-signal/web",
    "format": "prettier --write \".codex/schemas/*.json\" \"apps/web/lib/env/**/*.ts\" \"apps/web/lib/auth/**/*.ts\" \"apps/web/lib/db/postgres.ts\" \"apps/web/lib/db/repositories/**/*.ts\" \"apps/web/lib/db/supabase*.ts\" \"apps/web/proxy.ts\" \"apps/web/instrumentation.ts\" \"scripts/db/**/*.ts\" \"scripts/import-legacy-read-model.ts\" \"apps/web/eslint.config.mjs\" \".prettierrc.json\" \"package.json\" \"apps/web/package.json\"",
    "format:check": "prettier --check \".codex/schemas/*.json\" \"apps/web/lib/env/**/*.ts\" \"apps/web/lib/auth/**/*.ts\" \"apps/web/lib/db/postgres.ts\" \"apps/web/lib/db/repositories/**/*.ts\" \"apps/web/lib/db/supabase*.ts\" \"apps/web/proxy.ts\" \"apps/web/instrumentation.ts\" \"scripts/db/**/*.ts\" \"scripts/import-legacy-read-model.ts\" \"apps/web/eslint.config.mjs\" \".prettierrc.json\" \"package.json\" \"apps/web/package.json\"",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test:unit",
    "verify:data": "tsx scripts/verify-public-data.ts",
    "test:e2e": "npm run test:e2e --workspace @nagarik-signal/web",
    "test:unit": "tsx --test \"apps/web/**/*.test.ts\"",
    "test:env": "tsx --test apps/web/lib/env/schema.test.ts",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "db:test": "tsx --test \"scripts/db/*.test.ts\"",
    "legacy:import": "tsx scripts/import-legacy-read-model.ts",
    "anchor:prepare": "node scripts/prepare-anchor-test.mjs",
    "anchor:test": "npm run anchor:prepare && anchor test --skip-build",
    "anchor:test:devnet": "npm run anchor:prepare && anchor test --skip-build --skip-deploy --skip-local-validator --provider.cluster devnet",
    "anchor:build": "anchor build --no-idl",
    "anchor:deploy:devnet": "anchor deploy --provider.cluster devnet",
    "proof:create": "tsx scripts/create-issue.ts",
    "proof:verify": "tsx scripts/verify-issue.ts",
    "proof:status": "tsx scripts/update-status.ts",
    "proof:read": "tsx scripts/read-proof.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "sources:render": "tsx scripts/generate-source-dossiers.ts",
    "sources:import": "tsx scripts/import-public-sources.ts",
    "sessions:sweep": "tsx scripts/sweep-session-balances.ts",
    "verify:proof": "tsx scripts/verify-proof-cli.ts",
    "reindex": "tsx scripts/reindex.ts",
    "phase2:smoke": "tsx scripts/phase2-api-smoke.ts",
    "phase5:smoke": "tsx scripts/phase5-status-lifecycle-smoke.ts",
    "final:preflight": "tsx scripts/final-preflight.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@electric-sql/pglite": "0.5.4",
    "prettier": "3.9.6",
    "supabase": "2.110.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "next": "16.2.12"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "jayson": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.25"
    },
    "sharp": "0.35.3"
  }
}
