{
  "name": "nagarik-signal",
  "version": "0.1.0",
  "private": true,
  "description": "Public proof for public problems.",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.10.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nagarik-signal/web",
    "start": "npm run start --workspace @nagarik-signal/web",
    "build": "npm run build --workspace @nagarik-signal/web",
    "lint": "npm run lint --workspace @nagarik-signal/web",
    "typecheck": "npm run typecheck --workspace @nagarik-signal/web",
    "format": "prettier --write \"apps/web/app/api/internal/**/*.ts\" \"apps/web/app/api/media/**/*.ts\" \"apps/web/app/api/operator/**/*.ts\" \"apps/web/app/api/reports/**/*.ts\" \"apps/web/app/api/v2/**/*.ts\" \"apps/web/lib/api/**/*.ts\" \"apps/web/lib/chain/**/*.ts\" \"apps/web/lib/domain/**/*.ts\" \"apps/web/lib/env/**/*.ts\" \"apps/web/lib/auth/**/*.ts\" \"apps/web/lib/ops/**/*.ts\" \"apps/web/lib/security/capabilityTokens*.ts\" \"apps/web/lib/security/intakeCapability*.ts\" \"apps/web/lib/security/operatorMediaCapabilityCore.ts\" \"apps/web/lib/security/signalCapability*.ts\" \"apps/web/lib/security/trackingCapability*.ts\" \"apps/web/lib/security/workerAuth*.ts\" \"apps/web/lib/security/ids.ts\" \"apps/web/lib/security/session.ts\" \"apps/web/lib/geo/pilotGeometry*.ts\" \"apps/web/lib/server/paths.ts\" \"apps/web/lib/services/**/*.ts\" \"apps/web/lib/solana/**/*.ts\" \"apps/web/lib/storage/mediaAccess*.ts\" \"apps/web/lib/storage/normalizeImage.ts\" \"apps/web/lib/storage/publicDerivative.ts\" \"apps/web/lib/storage/sanitizeImage*.ts\" \"apps/web/lib/storage/privateStorage.ts\" \"apps/web/lib/storage/upload.ts\" \"apps/web/lib/db/postgres.ts\" \"apps/web/lib/db/query.ts\" \"apps/web/lib/db/queries.ts\" \"apps/web/lib/db/transaction.ts\" \"apps/web/lib/db/repositories/**/*.ts\" \"apps/web/lib/db/supabase*.ts\" \"apps/web/playwright.config.ts\" \"apps/web/proxy.ts\" \"apps/web/instrumentation.ts\" \"scripts/*.mjs\" \"scripts/bootstrap-v2-devnet.ts\" \"scripts/load-smoke*.ts\" \"scripts/release-evidence*.ts\" \"scripts/security-audit.ts\" \"scripts/verify-operational-evidence*.ts\" \"scripts/db/**/*.ts\" \"scripts/lib/chainWorkerRuntime.ts\" \"scripts/lib/nagarikClient.ts\" \"scripts/lib/releaseEvidence.ts\" \"scripts/import-legacy-read-model.ts\" \"scripts/process-outbox.ts\" \"scripts/reconcile-chain.ts\" \"tests/nagarik_signal_v2.ts\" \"tests/anchor_v2_transport.ts\" \"apps/web/eslint.config.mjs\" \".prettierrc.json\" \"package.json\" \"apps/web/package.json\"",
    "format:check": "prettier --check \"apps/web/app/api/internal/**/*.ts\" \"apps/web/app/api/media/**/*.ts\" \"apps/web/app/api/operator/**/*.ts\" \"apps/web/app/api/reports/**/*.ts\" \"apps/web/app/api/v2/**/*.ts\" \"apps/web/lib/api/**/*.ts\" \"apps/web/lib/chain/**/*.ts\" \"apps/web/lib/domain/**/*.ts\" \"apps/web/lib/env/**/*.ts\" \"apps/web/lib/auth/**/*.ts\" \"apps/web/lib/ops/**/*.ts\" \"apps/web/lib/security/capabilityTokens*.ts\" \"apps/web/lib/security/intakeCapability*.ts\" \"apps/web/lib/security/operatorMediaCapabilityCore.ts\" \"apps/web/lib/security/signalCapability*.ts\" \"apps/web/lib/security/trackingCapability*.ts\" \"apps/web/lib/security/workerAuth*.ts\" \"apps/web/lib/security/ids.ts\" \"apps/web/lib/security/session.ts\" \"apps/web/lib/geo/pilotGeometry*.ts\" \"apps/web/lib/server/paths.ts\" \"apps/web/lib/services/**/*.ts\" \"apps/web/lib/solana/**/*.ts\" \"apps/web/lib/storage/mediaAccess*.ts\" \"apps/web/lib/storage/normalizeImage.ts\" \"apps/web/lib/storage/publicDerivative.ts\" \"apps/web/lib/storage/sanitizeImage*.ts\" \"apps/web/lib/storage/privateStorage.ts\" \"apps/web/lib/storage/upload.ts\" \"apps/web/lib/db/postgres.ts\" \"apps/web/lib/db/query.ts\" \"apps/web/lib/db/queries.ts\" \"apps/web/lib/db/transaction.ts\" \"apps/web/lib/db/repositories/**/*.ts\" \"apps/web/lib/db/supabase*.ts\" \"apps/web/playwright.config.ts\" \"apps/web/proxy.ts\" \"apps/web/instrumentation.ts\" \"scripts/*.mjs\" \"scripts/bootstrap-v2-devnet.ts\" \"scripts/load-smoke*.ts\" \"scripts/release-evidence*.ts\" \"scripts/security-audit.ts\" \"scripts/verify-operational-evidence*.ts\" \"scripts/db/**/*.ts\" \"scripts/lib/chainWorkerRuntime.ts\" \"scripts/lib/nagarikClient.ts\" \"scripts/lib/releaseEvidence.ts\" \"scripts/import-legacy-read-model.ts\" \"scripts/process-outbox.ts\" \"scripts/reconcile-chain.ts\" \"tests/nagarik_signal_v2.ts\" \"tests/anchor_v2_transport.ts\" \"apps/web/eslint.config.mjs\" \".prettierrc.json\" \"package.json\" \"apps/web/package.json\"",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test:unit && npm run test:ops",
    "verify:data": "tsx scripts/verify-public-data.ts",
    "test:e2e": "npm run test:e2e --workspace @nagarik-signal/web",
    "test:unit": "tsx --test --test-concurrency=2 \"apps/web/**/*.test.ts\"",
    "test:env": "tsx --test apps/web/lib/env/schema.test.ts",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "audit:security": "tsx scripts/security-audit.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "db:test": "tsx --test \"scripts/db/*.test.ts\"",
    "legacy:import": "tsx scripts/import-legacy-read-model.ts",
    "outbox:process": "tsx scripts/process-outbox.ts",
    "chain:reconcile": "tsx scripts/reconcile-chain.ts",
    "chain:bootstrap:devnet": "tsx scripts/bootstrap-v2-devnet.ts",
    "anchor:prepare": "node scripts/prepare-anchor-test.mjs",
    "anchor:test": "npm run anchor:prepare && anchor test --skip-build",
    "anchor:build": "anchor build --no-idl",
    "anchor:idl:check": "node scripts/build-v2-idl.mjs && node scripts/verify-idl-drift.mjs",
    "proof:read": "tsx scripts/read-proof.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "sources:render": "tsx scripts/generate-source-dossiers.ts",
    "verify:proof": "tsx scripts/verify-proof-cli.ts",
    "reindex": "npm run chain:reconcile",
    "phase2:smoke": "tsx scripts/phase2-api-smoke.ts",
    "phase5:smoke": "tsx scripts/phase5-status-lifecycle-smoke.ts",
    "final:preflight": "tsx scripts/final-preflight.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "verify:release:report": "tsx scripts/verify-release.ts --allow-no-go",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "test:ops": "tsx --test \"scripts/*.test.ts\" && node --test \"infra/**/*.test.mjs\"",
    "ops:load-smoke": "tsx scripts/load-smoke.ts",
    "ops:verify-evidence": "tsx scripts/verify-operational-evidence.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@electric-sql/pglite": "0.5.4",
    "prettier": "3.9.6",
    "supabase": "2.110.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "next": "16.2.12"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "undici": "6.28.0",
    "jayson": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.25"
    },
    "sharp": "0.35.3"
  }
}
